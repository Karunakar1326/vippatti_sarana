<full-backup-content>
    <!-- The local login store holds salted password hashes and session
         state. Keep those off cloud backups / device-to-device transfer:
         restored sessions would bypass the re-login flow on a new device. -->
    <exclude domain="sharedpref" path="vippatti_sarana_auth.xml"/>
</full-backup-content>