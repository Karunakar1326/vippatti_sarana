<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules file; customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The local login store holds salted password hashes and session
             state. Keep those off cloud backups: restored sessions would
             bypass the re-login flow on a new device. -->
        <exclude domain="sharedpref" path="vippatti_sarana_auth.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vippatti_sarana_auth.xml"/>
    </device-transfer>
</data-extraction-rules>